# ---- LLM providers ----
OPENAI_API_KEY=
GEMINI_API_KEY=your_gemini_api_key
MODEL_NAME=gemini-2.0-flash
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# One of: router | gemini | groq | mock
LLM_PROVIDER=router

# ---- Database ----
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/ai_interview_agent

# ---- Auth / security ----
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Runtime / deployment ----
# development | production
APP_ENV=development
# Set to false in production. Gates the /debug/* endpoints.
DEBUG=false
# Comma-separated list of allowed frontend origins for CORS.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Frontend (frontend/.env.local) ----
# Base URL the browser uses to reach this backend. Must be set at build time.
# NEXT_PUBLIC_API_URL=http://localhost:8000
