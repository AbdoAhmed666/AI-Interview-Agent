# Copy to .env in this directory, then: docker compose up --build
#
#   cp .env.docker.example .env
#
# Every value below has a working default except SECRET_KEY, which compose
# refuses to start without.

# ---- Auth (REQUIRED) ----
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Database ----
# Consumed by the db service and used to build the backend's DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_interview_agent

# ---- LLM provider ----
# mock needs no API key and is what the tests use. Switch to gemini, groq or
# router once you have filled in the matching key below.
LLM_PROVIDER=mock
GEMINI_API_KEY=
MODEL_NAME=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Runtime ----
APP_ENV=development
DEBUG=false
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Ports and URLs ----
BACKEND_PORT=8000
FRONTEND_PORT=3000
# The address the browser uses to reach the API. Baked into the frontend image
# at build time, so change it before `docker compose build frontend`.
NEXT_PUBLIC_API_URL=http://localhost:8000
